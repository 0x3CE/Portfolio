{
  "name": "portfolio-aj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "fetch:data": "tsx scripts/fetch-contributions.ts && tsx scripts/fetch-repo-activity.ts",
    "prebuild": "npm run fetch:data",
    "build": "next build",
    "postbuild": "node scripts/strip-styleguide.mjs",
    "start": "npx --yes serve out -l 4321",
    "lint": "eslint . && tsc --noEmit",
    "shots": "playwright test",
    "import:strava": "tsx scripts/import-strava-csv.ts",
    "strava:probe": "tsx scripts/strava-probe.ts"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
